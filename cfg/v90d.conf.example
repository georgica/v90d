# v90d example configuration. Every key is shown; a key left out keeps the
# default, which is the value shown here except where noted.

[network]
# dhcp (default) or static. address and netmask are used in static mode.
lan = static
address = 192.168.1.2
netmask = 255.255.255.0
# the default route in static mode: an address in the same network, or none
gateway = none
# our end of the PPP link, and the address handed to the caller
ppp_local = 10.64.64.1
ppp_peer = 10.64.64.2
# DNS servers offered to the caller; `none` to leave one out
dns1 = 9.9.9.9
dns2 = 1.1.1.1
# masquerade the caller behind the LAN address
nat = on

[ppp]
# none (default), pap or chap. pap and chap need at least one user.
auth = chap
mru = 1500
# seconds between LCP echo requests, 0 = off
echo_interval = 30
# PPP compression (CCP) with callers that ask for it: Deflate (Linux pppd)
# or MPPC (Windows). Works on top of v42bis; off = never negotiated.
compression = on
# require 128-bit MPPE encryption (RFC 3078), set per port. on = force
# MS-CHAPv2 (so a user is needed), drop plain compression, and refuse a caller
# that will not do MPPE. off = no encryption. For Windows "require data
# encryption" dial-up. encryption = port 1, encryption2 = port 2.
encryption = off
encryption2 = off
# up to 16 users: name, then secret. Quote anything with blanks; inside
# quotes use \" \\ and \xHH.
user = alice wonderland
user = "bob smith" "correct horse \"battery\" staple"

[modem]
modulations = v90, v34, v32bis, v22bis, v22, v21
max_downstream = 56000
max_upstream = 33600
# transmit level in dBm0
tx_level = -12
v42 = on
v42bis = on
# on: offer V.92 PCM upstream to V.92 callers (then max_upstream may go up
# to 48000). off (default): V.90, upstream is V.34.
v92 = on
# on: offer x2 (U.S. Robotics' 56k of 1997) to a caller whose modem does it.
# Answering only, needs v34 in modulations, mu-law only. May be on for both
# ports; the daemon still serves only one heavy call (x2 or k56) at a time
# (x2 data mode takes most of the CPU). off (default).
x2 = off
# on: offer K56flex (the 1996 56k) to a caller whose modem does it.
# Experimental. Answering only, needs v34 in modulations, mu-law only. Shares
# the one heavy call at a time with x2. off (default).
k56 = off
# rings before answer
rings = 1
# ulaw (default) or alaw
law = ulaw

[line]
# the number callers must dial: 1 to 20 characters out of 0-9 * #, or `any`
# (default): every number connects.
number = 6387825442
# us (default) or eu: dial tone, ringback and busy cadences
tones = us
# percent of calls that get a busy signal instead of an answer
busy_chance = 0
# mean minutes of connect time before the line drops at random, 0 = never
drop_mean = 0
# hard limit of one call in minutes, 0 = none
session_limit = 0
# minutes without IP traffic before we hang up, 0 = none
idle_timeout = 0
# what a caller on this port gets: internet (as it is), archive (web and
# FTP from Protoweb, the web as it was), dreamcast (for the game console:
# no PPP compression, no V.92, the game revival name servers) or saturn
# (two consoles that telephone each other, joined over the network: dial 0
# to wait, #a*b*c*d# to call the player at that address). The last two have
# not been tried with a real console. webtv: for a WebTV or MSN TV box,
# whatever number it dials: PPP with any login (the box's own), no
# encryption, and its WebTV service sent to the WebTV server
# ([services] webtv_server).
service = internet
# for service = dreamcast, all off unless asked for: tell the "Dreamcast
# Now" site which game is being played; make the console a host of its own
# on the network (an address by DHCP) instead of hiding it behind the box;
# ask the network's router to pass the games' ports on (UPnP); keep an
# OpenVPN tunnel up to the network the IWANGO games' servers are in (needs
# a profile, given on the Dreamcast page)
#dreamcast_now = off
#dreamcast_lan = off
#dreamcast_upnp = off
#dreamcast_iwango = off
# for service = saturn, off unless asked for: pair players through the
# match server at saturn.dreampipe.net (makes the box a client of it)
#saturn_matchmaking = off

[status]
# lan (default) or off
listen = lan
port = 80
# password of the settings page (user name `admin`), quoted like a user
# secret. Empty: anyone on the LAN can change the settings.
admin_password = ""

[log]
# error, warn, info (default) or debug
level = info

[system]
# off (default) or on: once a day, check GitHub for a newer v90d release and,
# if there is one, offer it on the Firmware page (one click to install). Off
# means the box never contacts GitHub. Nothing is installed without a click.
update_check = off

[services]
# Numbers that connect a caller straight to a service on the internet, on
# either port: no PPP, the call carries what the modems send.
# on (default) or off: also answer the numbers of Netstalgia's signed list,
# which the box fetches once a day. Off means it never asks for it.
netstalgia = on
# the WebTV server, for a WebTV port's box and for WebTV for Dreamcast
# (a Dreamcast port's 10.0.1.129):
# redialed (default: WebTV Redialed, community.webtv.zone, looked up every
# 10 minutes; 31.97.100.150 until then), hacktv (HackTV Public Minisrv,
# 71.244.121.234), zefie (ZefieTV, 216.126.232.171), or the IPv4 address
# of a server of your own (one on your network is fine).
webtv_server = redialed
# service = NUMBER HOST:PORT raw|telnet NAME, up to 16. NUMBER is 3 to 15
# digits as dialled; raw passes the octets as they are, telnet says
# "Calling NAME ..." and speaks telnet. The host may be on your network.
# service = 5550100 192.168.1.20:23 telnet My board
