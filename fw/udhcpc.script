#!/bin/sh
# Lease handler for busybox udhcpc. Ours; written for this image.
# udhcpc sets: interface ip subnet router dns
case "$1" in
deconfig)
    ifconfig "$interface" 0.0.0.0
    echo 0 > /sys/class/leds/ht802:wan/brightness 2>/dev/null
    ;;
bound|renew)
    ifconfig "$interface" "$ip" netmask "${subnet:-255.255.255.0}"
    if [ -n "$router" ]; then
        while route del default dev "$interface" 2>/dev/null; do :; done
        for r in $router; do route add default gw "$r" dev "$interface"; break; done
    fi
    : > /tmp/resolv.conf
    for d in $dns; do echo "nameserver $d" >> /tmp/resolv.conf; done
    # the network light: we have an address
    echo 1 > /sys/class/leds/ht802:wan/brightness 2>/dev/null
    ;;
esac
exit 0
