#!/bin/sh
# v90d on the Obihai OBi200: this file is /obi/obi, which the maker's
# /etc/rc starts at boot in place of the maker's application. U-Boot, the
# kernel in the flash and the root file system are the maker's (or the
# community firmware's) and stay as they were; only the /obi partition is
# ours.
#
# Two kernels. Started by the maker's kernel, this first starts v90d's own
# Linux kernel (kernel.xz) from RAM (kjump), unless that did not come up
# twice in a row since the power came on (kjump --count) or
# /scratch/v90d/maker-kernel exists: the box then stays on the maker's
# kernel, with the maker's modules below. v90d's own kernel runs this again
# (from kinit) and the same programs run on it.
#
#   ffxav_*.ko    the maker's telephony, LED and watchdog modules, taken
#                 from the owner's own firmware file by mkobifw.py
#   obiline       our line driver in user space (fw/obi/obiline.c), served
#                 to the daemon on /var/run/v90line
#   v90d          the daemon; settings in /scratch/v90d (the box's writable
#                 flash), the status and settings pages on the LAN port
# Ours; written for this image.

D=${V90D_DIR:-/obi}
PATH=/sbin:/usr/sbin:/bin:/usr/bin
export PATH
say() { echo "v90d: $*"; logger -t v90d "$*" 2>/dev/null; }

# the line's audio loop runs SCHED_FIFO all the time
sysctl -w kernel.sched_rt_runtime_us=-1 >/dev/null 2>&1

cd $D || exit 1
# which kernel: the maker's is 2.6.30
OWN=1
case "$(uname -r)" in 2.*) OWN= ;; esac

if [ -z "$OWN" ]; then
    # the maker's modules, in the maker's order (its start script loads the
    # watchdog's too; we never open the watchdog device, and the box runs on)
    for m in ffxav_mp ffxav_led ffxav_wdt; do
        grep -q "^$m " /proc/modules || insmod $D/$m.ko || say "cannot load $m.ko"
    done
    # their device nodes, at once (the maker's udev, or v90d's root file
    # system's mdev, would make them a moment later: kjump needs /dev/led now)
    for c in /sys/class/telephony/* /sys/class/led/* /sys/class/watchdog/*; do
        [ -f "$c/dev" ] && [ ! -e "/dev/${c##*/}" ] || continue
        IFS=: read ma mi < "$c/dev"
        mknod "/dev/${c##*/}" c "$ma" "$mi"
    done
    # v90d's own kernel, if it is here and may start (see above). kjump
    # needs the LED module (it runs its last step through /dev/led); the
    # telephony module's audio keeps running and the new kernel takes it over.
    if [ -f $D/kernel.xz ] && [ ! -e /scratch/v90d/maker-kernel ]; then
        if $D/kjump --count try; then
            say "starting v90d's own kernel"
            sync
            $D/kjump $D/kernel.xz $D/kjump.stub 2>&1 | logger -t kjump
            say "v90d's own kernel did not start: the maker's kernel this time"
        else
            say "v90d's own kernel did not come up twice: the maker's kernel until the power goes off"
        fi
    fi
fi

# settings: kept in /scratch, the factory ones until the first save
mkdir -p /scratch/v90d
CONF=/scratch/v90d/v90d.conf
[ -s $CONF ] || cp $D/v90d.conf $CONF
if ! $D/v90d -c $CONF -p >/dev/null 2>&1; then
    say "the saved settings are not understood by this firmware: factory settings for now"
    CONF=/tmp/v90d.conf
    cp $D/v90d.conf $CONF
fi
chmod 600 $CONF

# The LAN port. The Ethernet controller's own device (unm) carries the
# switch's tagged frames; the routed interface eth1 is made on top of it with
# the unit's MAC, as the maker's application does at boot (unicfg -gwadd ...
# and two switch register writes, read off a box starting up). The MAC is in
# the factory block of the flash, after "OB100 UNIT INFO" at 0x40000.
# Under v90d's own kernel the port is eth0 (fw/kernel ffxav_eth.c, which sets
# the switch up itself) and the factory block is its own partition, mtd1.
LAN=eth1 FACTORY=/dev/mtdblock6 AT=262144 MACAT=262400
[ -n "$OWN" ] && LAN=eth0 FACTORY=/dev/mtdblock1 AT=0 MACAT=256
unit_mac() {
    [ "$(hexdump -s $AT -n 15 -e '15/1 "%c"' $FACTORY 2>/dev/null)" = "OB100 UNIT INFO" ] || return 1
    hexdump -s $MACAT -n 6 -e '5/1 "%02x:" 1/1 "%02x"' $FACTORY 2>/dev/null
}
if [ -n "$OWN" ]; then
    MAC=$(unit_mac) || { MAC=02:90:d0:00:00:01; say "no unit MAC in the flash: $MAC for now"; }
    ifconfig $LAN down
    ifconfig $LAN hw ether $MAC
elif [ ! -d /sys/class/net/$LAN ]; then
    MAC=$(unit_mac) || { MAC=02:90:d0:00:00:01; say "no unit MAC in the flash: $MAC for now"; }
    ifconfig unm down 2>/dev/null
    unicfg -gwadd $LAN 0 $MAC 0x2f >/dev/null 2>&1 || say "cannot make $LAN"
    swcfg -sw 0 5 9 0x28 >/dev/null 2>&1
    swcfg -sw 0 5 0xa 0xb0c8 >/dev/null 2>&1
fi
eval "$($D/v90d -c $CONF -p)" || LAN_MODE=dhcp
ifconfig lo 127.0.0.1 up
ifconfig $LAN 0.0.0.0 allmulti up
# the rescue address, as the HT802 has it: whatever the settings say and
# whether DHCP answers or not, the box's pages are also at 169.254.90.1 (a
# computer on the same cable with an address in 169.254.0.0/16 reaches it)
ifconfig $LAN:9 169.254.90.1 netmask 255.255.0.0 2>/dev/null || say "no rescue address"
if [ "$LAN_MODE" = static ]; then
    ifconfig $LAN "$LAN_ADDRESS" netmask "$LAN_NETMASK"
    [ -n "$LAN_GATEWAY" ] && route add default gw "$LAN_GATEWAY" dev $LAN
    : > /var/tmp/resolv.conf
    for d in $LAN_DNS1 $LAN_DNS2; do echo "nameserver $d" >> /var/tmp/resolv.conf; done
    say "LAN $LAN_ADDRESS (fixed)"
else
    # -x hostname: is today's BusyBox (v90d's root file system); the maker's
    # older one knows only -H, and refuses the other
    udhcpc -i $LAN -b -s $D/udhcpc.script -x hostname:v90d -p /var/run/${LAN}udhcpc.pid >/dev/null 2>&1 ||
        udhcpc -i $LAN -b -s $D/udhcpc.script -H v90d -p /var/run/${LAN}udhcpc.pid >/dev/null 2>&1 ||   # the maker's BusyBox only
        say "cannot start udhcpc"
    say "LAN by DHCP"
fi

# the box has no battery clock: the call history wants the time of day
( sleep 15; ntpd -q -p pool.ntp.org ) >/dev/null 2>&1 &

# The Firmware page's flash tool. Under v90d's own kernel the whole chip
# (mtd7) is read only; what obinv writes goes through the "firmware"
# partition (mtd8, from 0x50000: never U-Boot or the factory block).
if [ -n "$OWN" ]; then
    OBINV_FLASH=/dev/mtd7 OBINV_FLASH_WR=/dev/mtd8 OBINV_FLASH_WR_AT=0x50000
    export OBINV_FLASH OBINV_FLASH_WR OBINV_FLASH_WR_AT
fi
# what the Firmware page shows about how this box keeps its firmware
$D/obinv where > /tmp/v90d.where 2>/dev/null

# the line, then the daemon on it; each started again if it ever stops.
# The Firmware page's flash tool is obinv (fw/obi/obinv.c).
( while :; do $D/obiline -s /var/run/v90line 2>&1 | logger -t obiline; sleep 2; done ) &
sleep 2
# The 1-800-BBS-DIAL list and the numbers of services: the ones in the
# image, then Netstalgia's signed ones, fetched daily (fw/bbsfetch.sh).
( while :; do $D/v90d -c $CONF -l seq:/var/run/v90line -i $LAN -t ppp0 -N $D/obinv \
    -V /scratch/v90d/vpn.ovpn -B $D/bbs.txt -b "sh $D/bbsfetch.sh" \
    -F $D/services.txt -f "sh $D/bbsfetch.sh http://api.netstalgia.online/v1/services.txt 'v90d-svc 1'" \
    2>&1 | logger -t v90d; sleep 2; done ) &

# The Restart button, and the Firmware page once it has written the flash,
# leave a note: restart then (the settings are written as they are saved).
( while sleep 2; do
    [ -f /tmp/v90d.restart ] || continue
    say "restart asked"; sync; sleep 1
    # under v90d's own kernel process 1 is kinit, not an init that restarts
    if [ -n "$OWN" ]; then reboot -f; else reboot; fi
  done ) &
say "started"
