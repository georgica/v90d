# v90d kernel for the Obihai OBi200 (Marvell FFxAV): bring-up, RAM-booted
# (fw/obi, kjump). gzip: the image unpacks well inside the watchdog's time.
CONFIG_KERNEL_GZIP=y
CONFIG_DEFAULT_HOSTNAME="v90d"
# CONFIG_SWAP is not set
CONFIG_SYSVIPC=y
CONFIG_HZ_PERIODIC=y
CONFIG_PREEMPT=y
CONFIG_LOG_BUF_SHIFT=15
CONFIG_BLK_DEV_INITRD=y
# CONFIG_RD_GZIP is not set
# CONFIG_RD_BZIP2 is not set
# CONFIG_RD_LZMA is not set
# CONFIG_RD_XZ is not set
# CONFIG_RD_LZO is not set
# CONFIG_RD_LZ4 is not set
# CONFIG_RD_ZSTD is not set
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
CONFIG_EXPERT=y
CONFIG_KALLSYMS=y
# CONFIG_ARCH_MULTI_V7 is not set
CONFIG_ARCH_MULTI_V5=y
CONFIG_ARCH_FFXAV=y
CONFIG_AEABI=y
CONFIG_ZBOOT_ROM_TEXT=0
CONFIG_ZBOOT_ROM_BSS=0
CONFIG_ARM_APPENDED_DTB=y
# CONFIG_ATAGS is not set
# CONFIG_SUSPEND is not set
# CONFIG_COREDUMP is not set
CONFIG_SLUB_TINY=y
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
# v90d's own networking, as on the HT802: PPP in user space over TUN,
# nftables NAT for the callers
CONFIG_NETFILTER=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_CT=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_REDIR=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_IPV6=y
# CONFIG_IPV6_SIT is not set
CONFIG_NF_TABLES_IPV6=y
# CONFIG_WIRELESS is not set
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
# CONFIG_FW_LOADER is not set
CONFIG_NETDEVICES=y
CONFIG_TUN=y
CONFIG_FFXAV_ETH=y
# CONFIG_INPUT is not set
# CONFIG_SERIO is not set
# CONFIG_VT is not set
# CONFIG_LEGACY_PTYS is not set
# telephony (TDM-NOTES.md): SLIC reset pin, /dev/fxs0, /dev/fxs1, /dev/pcm
CONFIG_SPI=y
CONFIG_GPIOLIB=y
CONFIG_GPIO_FFXAV=y
CONFIG_FFXAV_TEL=y
# SPI controller + flash, watchdog, LEDs (SPI-LED-WDT-NOTES.md); the flash's
# write protection bits are left as they are
CONFIG_MTD=y
CONFIG_MTD_SPI_NOR=y
# the stock root file system (mtd3) and v90d's own (/obi, mtd5): squashfs on
# MTD block devices, as on the stock system
CONFIG_MTD_BLOCK_RO=y
# 64 KiB erase blocks, as the stock system made /scratch (JFFS2) with
# CONFIG_MTD_SPI_NOR_USE_4K_SECTORS is not set
CONFIG_MTD_SPI_NOR_SWP_KEEP=y
CONFIG_SPI_FFXAV=y
CONFIG_WATCHDOG=y
CONFIG_FFXAV_WATCHDOG=y
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_GPIO=y
CONFIG_LEDS_FFXAV_PHY=y
CONFIG_LEDS_TRIGGERS=y
CONFIG_LEDS_TRIGGER_TIMER=y
CONFIG_LEDS_TRIGGER_HEARTBEAT=y
CONFIG_LEDS_TRIGGER_DEFAULT_ON=y
# CONFIG_HW_RANDOM is not set
# CONFIG_HWMON is not set
# CONFIG_USB_SUPPORT is not set
# CONFIG_IOMMU_SUPPORT is not set
CONFIG_TMPFS=y
# the settings partition (/scratch), shared with the stock system
CONFIG_MISC_FILESYSTEMS=y
CONFIG_JFFS2_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_FILE_DIRECT=y
CONFIG_SQUASHFS_DECOMP_SINGLE=y
CONFIG_SQUASHFS_ZLIB=y
# CONFIG_NETWORK_FILESYSTEMS is not set
CONFIG_PRINTK_TIME=y
CONFIG_DEVMEM=y
CONFIG_INITRAMFS_COMPRESSION_NONE=y
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
