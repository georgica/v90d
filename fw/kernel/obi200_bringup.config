# Bring-up additions to obi200_defconfig (fw/obi/ramboot): the low-level
# debug log in RAM (0x03f20000, read back by run.sh after the restart; the
# kernel writes it with the "earlyprintk" argument of the bring-up device
# tree) and the RAM early console. Merge after the defconfig:
#   scripts/kconfig/merge_config.sh -m -O $OUT $OUT/.config fw/kernel/obi200_bringup.config
CONFIG_DEBUG_LL=y
CONFIG_DEBUG_FFXAV_RAM=y
CONFIG_EARLY_PRINTK=y
CONFIG_SERIAL_EARLYCON_RAM=y
